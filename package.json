{
  "name": "aura-atelier",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Luxury Wedding & Event Architecture Platform with 3D Spatial Venue Studio, Smart INR Budget Engine, Vendor Negotiator, Molecular Allergen Scout, and 1P Google Workspace Sync",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test src/**/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --ext .ts,.tsx || tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@react-three/cannon": "^6.6.0",
    "@types/cors": "^2.8.19",
    "cannon-es": "^0.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "firebase": "^13.1.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
